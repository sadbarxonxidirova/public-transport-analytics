@startuml
entity agency {
  * agency_id : INTEGER <<PK>>
  --
  * agency_code : TEXT <<UNIQUE>>
  * agency_name : TEXT
  * city_region : TEXT
}
entity route {
  * route_pk : INTEGER <<PK>>
  --
  * agency_id : INTEGER <<FK>>
  * source_route_id : TEXT
  ..
  UNIQUE(agency_id, source_route_id)
}
entity route_period {
  * route_period_id : INTEGER <<PK>>
  --
  * route_pk : INTEGER <<FK>>
  * period_code : TEXT
  * summary_begin_date : TEXT
  stops : REAL
  avg_on_per_trip : REAL
  avg_trips : REAL
  sum_ons : REAL
  avg_ons : REAL
  * source_file : TEXT
  ..
  UNIQUE(route_pk, period_code)
}
agency ||--o{ route : has
route ||--o{ route_period : measured_in
@enduml
